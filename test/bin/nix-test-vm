#!/usr/bin/env bash
# Entry point for the macos-single-user-nix VM test harness.
#
# Subcommands:
#   pull-base                Pull the vanilla Cirrus base image (~25 GB, one-time).
#   pave                     Clone base → 'nix-paved-tahoe', boot, install SSH key + sudoers, snapshot.
#   playbook <name>          Run a playbook from test/playbooks/<name>.sh against a fresh clone.
#                            The clone loses passwordless sudo, and the installer runs in a
#                            terminal, answered as a person would. The whole run is saved to
#                            test/output/<commit>/<name>.txt.
#   ssh <vm-name>            sshpass into a running VM.
#   list                     Show tart VMs whose names start with 'nix-'.
#   clean                    Stop + delete all 'nix-test-*' VMs (leaves base + paved).
#
# Env knobs (most have sensible defaults):
#   BASE_IMAGE   ghcr.io/cirruslabs/macos-sequoia-vanilla:latest
#   PAVED_NAME   nix-paved-tahoe
#   VM_USER      admin
#   VM_PASS      admin
#   SSH_KEY      path to a private key; used for non-password SSH after paving.
#                Default: ~/.ssh/nix-vm-key (auto-generated by `pave`).
#   KEEP_VM      1 = leave the test VM around after a playbook run for debugging.

set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
TEST_DIR="$(cd "$HERE/.." && pwd)"
# shellcheck disable=SC1091
source "$TEST_DIR/lib/vm.sh"

BASE_IMAGE="${BASE_IMAGE:-ghcr.io/cirruslabs/macos-tahoe-vanilla:26.6.2}"
PAVED_NAME="${PAVED_NAME:-nix-paved-tahoe}"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/nix-vm-key}"

usage() {
  sed -n '2,/^set -/p' "$0" | sed 's/^# \{0,1\}//; /^set -/d'
  exit "${1:-0}"
}

cmd_pull_base() {
  require_tart
  log "pulling $BASE_IMAGE (this is ~25 GB and only needs to happen once)"
  tart pull "$BASE_IMAGE"
}

ensure_ssh_key() {
  if [[ ! -f "$SSH_KEY" ]]; then
    log "generating SSH key at $SSH_KEY"
    mkdir -p "$(dirname "$SSH_KEY")"
    ssh-keygen -t ed25519 -N "" -f "$SSH_KEY" -C "nix-vm-key" >/dev/null
  fi
}

cmd_pave() {
  require_tart
  require_sshpass
  ensure_ssh_key

  if vm_exists "$PAVED_NAME"; then
    die "$PAVED_NAME already exists. Delete it first: tart delete $PAVED_NAME"
  fi

  # Pave from the base image. The result is a stopped VM with our SSH key
  # installed and passwordless sudo for $VM_USER — downstream clones inherit
  # both, so test runs don't need sshpass or interactive sudo.
  vm_clone "$BASE_IMAGE" "$PAVED_NAME"
  vm_start "$PAVED_NAME"

  # During paving, we must use the password (SSH key isn't installed yet).
  local saved_key="$SSH_KEY"
  SSH_KEY=""
  local ip
  ip=$(vm_wait_ssh "$PAVED_NAME" 300)
  log "paved VM up at $ip — installing SSH key + sudoers"

  local pub
  pub=$(cat "${saved_key}.pub")
  vm_ssh "$ip" "mkdir -p ~/.ssh && chmod 700 ~/.ssh && echo '$pub' >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys"
  # Passwordless sudo for $VM_USER, so install.sh's `sudo -v` warm-up is a no-op.
  vm_sudo_sh "$ip" "echo '$VM_USER ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/nix-test && chmod 440 /etc/sudoers.d/nix-test"

  # Sanity: SSH back in with the key.
  SSH_KEY="$saved_key"
  vm_ssh "$ip" true || die "post-pave SSH-key login failed"
  vm_sudo "$ip" "-n true" || die "post-pave passwordless sudo not working"

  # Flush guest FS cache — tart stop won't, and unsynced writes are lost.
  vm_ssh "$ip" sync
  log "stopping $PAVED_NAME — paved snapshot ready"
  vm_stop "$PAVED_NAME"
  # tart keeps stopped VMs as reusable snapshots; just leave it.
}

cmd_playbook() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: nix-test-vm playbook <name>"
  local playbook="$TEST_DIR/playbooks/$name.sh"
  [[ -f "$playbook" ]] || die "playbook not found: $playbook"

  require_tart
  ensure_ssh_key
  vm_exists "$PAVED_NAME" || die "no paved snapshot ($PAVED_NAME). Run: nix-test-vm pave"

  local root commit
  root="$(cd "$TEST_DIR/.." && pwd)"
  commit="$(git -C "$root" rev-parse --short=7 HEAD)"
  [[ -z "$(git -C "$root" status --porcelain -- . ':!test/output')" ]] \
    || die "the working tree has uncommitted changes; commit first so the output is saved under the commit it tested"
  local out_dir="$TEST_DIR/output/$commit"
  mkdir -p "$out_dir"

  # The playbook's whole terminal output is saved, carriage returns dropped.
  { _run_playbook "$name" "$playbook" 2>&1; } | tee >(tr -d '\r' > "$out_dir/$name.txt")
}

_run_playbook() {
  local name="$1" playbook="$2" self="$BASHPID"
  export VM_NAME="nix-test-${name}-$$"
  export PAVED_NAME SSH_KEY VM_USER VM_PASS BASE_IMAGE
  export TEST_DIR
  TERMINAL_RUN_DIR="$(mktemp -d)"
  export TERMINAL_RUN_DIR

  # shellcheck disable=SC2329  # runs from the EXIT trap
  cleanup() {
    set +e
    [[ -n "${WATCHDOG_PID:-}" ]] && kill "$WATCHDOG_PID" 2>/dev/null
    if [[ "${KEEP_VM:-0}" == "1" ]]; then
      log "KEEP_VM=1 — leaving $VM_NAME running. Inspect with:"
      log "  $0 ssh $VM_NAME"
      log "  tart stop $VM_NAME && tart delete $VM_NAME    # when done"
      return
    fi
    log "tearing down $VM_NAME"
    vm_stop "$VM_NAME"
    vm_delete "$VM_NAME"
  }
  trap cleanup EXIT

  log "playbook: $name → $VM_NAME (clone of $PAVED_NAME)"
  vm_clone "$PAVED_NAME" "$VM_NAME"
  vm_start "$VM_NAME"
  IP=$(vm_wait_ssh "$VM_NAME" 300)
  export IP
  log "VM up at $IP — running playbook"

  # A playbook gets one hour, then it is killed (which tears the VM down).
  # The sleep is killed with the watchdog, or it would hold the output pipe open.
  (
    trap 'kill "$sleeper" 2>/dev/null' TERM
    sleep 3600 &
    sleeper=$!
    wait "$sleeper" && { warn "playbook exceeded 1 hour"; kill -TERM "$self"; }
  ) &
  WATCHDOG_PID=$!
  scenario setup/remove-passwordless-sudo.sh

  # shellcheck disable=SC1090
  source "$playbook"

  scenario verify/pauses-answered.sh

  log "PASS — playbook '$name' completed"
}

cmd_ssh() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: nix-test-vm ssh <vm-name>"
  require_tart
  ensure_ssh_key
  local ip
  ip=$(vm_ip "$name") || die "VM $name not running"
  [[ -n "$ip" ]] || die "VM $name has no IP yet"
  exec ssh -i "$SSH_KEY" -o IdentitiesOnly=yes "${SSH_OPTS[@]}" "$VM_USER@$ip"
}

cmd_list() {
  require_tart
  tart list | awk 'NR==1 || $2 ~ /^nix-/'
}

cmd_clean() {
  require_tart
  local name
  while read -r name; do
    [[ -n "$name" ]] || continue
    log "deleting $name"
    vm_stop "$name"
    vm_delete "$name"
  done < <(tart list 2>/dev/null | awk '$2 ~ /^nix-test-/ {print $2}')
}

# --- dispatch ---------------------------------------------------------------

sub="${1:-}"
shift || true
case "$sub" in
  pull-base) cmd_pull_base "$@" ;;
  pave)      cmd_pave "$@" ;;
  playbook)  cmd_playbook "$@" ;;
  ssh)       cmd_ssh "$@" ;;
  list)      cmd_list "$@" ;;
  clean)     cmd_clean "$@" ;;
  -h|--help|"") usage 0 ;;
  *) usage 1 ;;
esac
