#!/usr/bin/env bash
# Builds REPORT.md from test/runs.jsonl and the terminal output the suite saved
# under test/output/<commit>/<playbook>.txt, and writes the README badge.
#
# One table row per macOS and Nix combination, showing that combination's
# newest run (the last line in test/runs.jsonl), pass or fail, sorted by macOS then
# Nix, highest first. Under the table, each row's run gets one collapsed
# section per playbook holding its raw terminal output.
#
# The README badge is the line starting "[![tested on". It names the macOS and
# Nix versions of the newest passing line of test/runs.jsonl, or says no run has
# passed.
#
# Env knobs (for tests): RUNS_FILE, OUTPUT_DIR, REPORT_FILE, README_FILE.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
RUNS_FILE="${RUNS_FILE:-$ROOT/test/runs.jsonl}"
OUTPUT_DIR="${OUTPUT_DIR:-$ROOT/test/output}"
REPORT_FILE="${REPORT_FILE:-$ROOT/REPORT.md}"
README_FILE="${README_FILE:-$ROOT/README.md}"

# field <json-line> <name>: a top-level string field of a flat JSON object.
field() {
  sed -n "s/.*\"$2\":\"\([^\"]*\)\".*/\1/p" <<< "$1"
}

# playbook_results <json-line>: one "name result" per playbook, in order.
playbook_results() {
  grep -o '"playbooks":{[^}]*}' <<< "$1" \
    | grep -o '"[^"]*":"[^"]*"' \
    | sed 's/^"\([^"]*\)":"\([^"]*\)"$/\1 \2/'
}

# pad <dotted version>: components zero-padded so a plain sort orders versions.
pad() {
  awk -F. '{ for (i = 1; i <= NF; i++) printf "%09d.", $i; print "" }' <<< "$1"
}

[[ -f "$RUNS_FILE" ]] || { echo "build-report: no $RUNS_FILE" >&2; exit 1; }

# The newest line of each macOS and Nix combination, highest versions first.
rows=$(
  n=0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    n=$(( n + 1 ))
    printf '%s|%s|%09d|%s\n' \
      "$(pad "$(field "$line" macos)")" "$(pad "$(field "$line" nix)")" "$n" "$line"
  done < "$RUNS_FILE" \
    | sort -r \
    | awk -F'|' '{ key = $1 "|" $2 } key != seen { print; seen = key }' \
    | cut -d'|' -f4-
)

{
  echo "# Run history"
  echo
  echo "A passing run means: a fresh macOS VM, the installer run through its three phases across"
  echo "a real reboot, answered as a person would. The password is typed at sudo's own prompt and"
  echo "Enter is pressed at every pause the installer prints."
  echo
  echo "One row per macOS and Nix combination, showing its newest run, whether it passed or failed."
  echo
  echo "| Result | macOS | Nix | Commit | Date |"
  echo "|---|---|---|---|---|"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    result=$(field "$line" result)
    glyph="❌"; [[ "$result" == pass ]] && glyph="✅"
    # shellcheck disable=SC2016  # the backticks are Markdown
    printf '| %s %s | %s | %s | `%s` | %s |\n' "$glyph" "$result" \
      "$(field "$line" macos)" "$(field "$line" nix)" \
      "$(field "$line" commit | cut -c1-7)" "$(field "$line" date)"
  done <<< "$rows"
  echo
  echo "To reproduce a run, see [test/README.md](test/README.md)."
  echo "[test/runs.jsonl](test/runs.jsonl) is the source of the table; \`test/bin/build-report\` builds this page."
  echo
  echo "## Terminal output"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    short=$(field "$line" commit | cut -c1-7)
    echo
    echo "### macOS $(field "$line" macos), Nix $(field "$line" nix), commit \`$short\`"
    found=0
    while read -r name result; do
      [[ -n "$name" ]] || continue
      file="$OUTPUT_DIR/$short/$name.txt"
      [[ -f "$file" ]] || continue
      found=1
      echo
      echo "<details>"
      echo "<summary>$name: $result</summary>"
      echo
      echo "~~~text"
      cat "$file"
      echo "~~~"
      echo
      echo "</details>"
    done < <(playbook_results "$line")
    if (( found == 0 )); then
      echo
      echo "No terminal output was saved for this run."
    fi
  done <<< "$rows"
} > "$REPORT_FILE"

# The badge: the newest passing line, or a grey badge when none has passed.
# shields.io reads "-" as a separator and "--" as a literal dash.
badge_text() { sed 's/-/--/g; s/ /%20/g' <<< "$1"; }
newest_pass=""
while IFS= read -r line; do
  [[ "$(field "$line" result)" == pass ]] && newest_pass="$line"
done < "$RUNS_FILE"
if [[ -n "$newest_pass" ]]; then
  value="macOS $(field "$newest_pass" macos), Nix $(field "$newest_pass" nix)"
  color=brightgreen
else
  value="no passing run"
  color=lightgrey
fi
badge="[![tested on $value](https://img.shields.io/badge/tested%20on-$(badge_text "$value")-$color)](REPORT.md)"
if [[ -f "$README_FILE" ]] && grep -q '^\[!\[tested on' "$README_FILE"; then
  tmp="$README_FILE.tmp"
  while IFS= read -r l || [[ -n "$l" ]]; do
    if [[ "$l" == "[![tested on"* ]]; then printf '%s\n' "$badge"; else printf '%s\n' "$l"; fi
  done < "$README_FILE" > "$tmp"
  mv "$tmp" "$README_FILE"
fi
